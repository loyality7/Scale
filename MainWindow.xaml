<Window x:Class="ScaleWindows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Scale" 
        Icon="app.ico"
        Height="900" Width="1440"
        MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#0E0E0E"
        Foreground="#F5F5F5"
        FontFamily="Segoe UI, system-ui, sans-serif"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="MainWindow_Closing">

    <Window.Resources>
        <!-- Single Unified Clean Dark Theme Tokens -->
        <SolidColorBrush x:Key="ColorSurfaceBase" Color="#0E0E0E"/>
        <SolidColorBrush x:Key="ColorPanelBg" Color="#181818"/>
        <SolidColorBrush x:Key="ColorPanelHeader" Color="#222222"/>
        <SolidColorBrush x:Key="ColorBorder" Color="#2E2E2E"/>
        <SolidColorBrush x:Key="ColorAccent" Color="#f08a4b"/>
        <SolidColorBrush x:Key="ColorTextPrimary" Color="#F5F5F5"/>
        <SolidColorBrush x:Key="ColorTextSecondary" Color="#9E9E9E"/>

        <!-- Toolbar Button Style (Icon top, label bottom, exact Scale style) -->
        <Style TargetType="Button" x:Key="ToolbarButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9E9E9E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#252525"/>
                                <Setter Property="Foreground" Value="#f08a4b"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#151515"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toolbar Toggle Button -->
        <Style TargetType="ToggleButton" x:Key="ToolbarToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9E9E9E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="TglBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TglBorder" Property="Background" Value="#252525"/>
                                <Setter Property="Foreground" Value="#f08a4b"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TglBorder" Property="Background" Value="#2C1D13"/>
                                <Setter Property="Foreground" Value="#f08a4b"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented Tab Button -->
        <Style TargetType="RadioButton" x:Key="SegmentedTab">
            <Setter Property="Background" Value="#202020"/>
            <Setter Property="Foreground" Value="#9E9E9E"/>
            <Setter Property="BorderBrush" Value="#2E2E2E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#f08a4b"/>
                                <Setter Property="Foreground" Value="#000000"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#f08a4b"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#F5F5F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider Theme -->
        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,2,0,8"/>
        </Style>

        <!-- HUD Label -->
        <Style TargetType="TextBlock" x:Key="HudLabel">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#9E9E9E"/>
            <Setter Property="Margin" Value="0,3,0,2"/>
        </Style>

        <!-- HUD Input Box -->
        <Style TargetType="TextBox" x:Key="HudInput">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#F5F5F5"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Consolas, monospace"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Panel Close Button -->
        <Style TargetType="Button" x:Key="PanelCloseBtn">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="6" Background="#FF5F56" BorderBrush="#E0443E" BorderThickness="1"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBox ToggleButton -->
        <ControlTemplate x:Key="DarkComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="Border" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="22"/>
                    </Grid.ColumnDefinitions>
                    <Path x:Name="Arrow" Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#9E9E9E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#f08a4b"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="#f08a4b"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Dark ComboBox with Dark Popup (Fixes White Box) -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F5F5F5"/>
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" 
                                          Template="{StaticResource DarkComboBoxToggleButton}" 
                                          Focusable="False" 
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                          ClickMode="Press"/>
                            <ContentPresenter x:Name="ContentSite" 
                                              IsHitTestVisible="False" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                              Margin="8,2,24,2" 
                                              VerticalAlignment="Center" 
                                              HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup" 
                                   Placement="Bottom" 
                                   IsOpen="{TemplateBinding IsDropDownOpen}" 
                                   AllowsTransparency="True" 
                                   Focusable="False" 
                                   PopupAnimation="Fade">
                                <Grid x:Name="DropDown" 
                                      SnapsToDevicePixels="True" 
                                      MinWidth="{TemplateBinding ActualWidth}" 
                                      MaxHeight="280">
                                    <Border x:Name="DropDownBorder" 
                                            Background="#141414" 
                                            BorderBrush="#383838" 
                                            BorderThickness="1" 
                                            CornerRadius="4" 
                                            Margin="0,2,0,0">
                                        <ScrollViewer Margin="2,4" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBoxItem Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F5F5F5"/>
            <Setter Property="Background" Value="#141414"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="3" Margin="2,1">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2D2D2D"/>
                                <Setter Property="Foreground" Value="#f08a4b"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#382416"/>
                                <Setter Property="Foreground" Value="#f08a4b"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Dark ProgressBar Style -->
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="10"/>
            <Setter Property="Background" Value="#222222"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" ClipToBounds="True">
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="5">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#f08a4b" Offset="0.0"/>
                                            <GradientStop Color="#FF9D5C" Offset="0.5"/>
                                            <GradientStop Color="#00E5FF" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#0E0E0E">
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/> <!-- Top Toolbar (Exact Scale Replica) -->
            <RowDefinition Height="*"/>  <!-- Full-Window Canvas Viewport with Floating Panels -->
        </Grid.RowDefinitions>

        <!-- ================= TOP TOOLBAR ================= -->
        <Border Grid.Row="0" Background="#161616" BorderBrush="#262626" BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Basic Controls (Zoom In, Zoom Out, Random, Enter/Random Equation, Save) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Brand Label -->
                    <TextBlock Text="Scale" FontSize="14" FontWeight="Bold" Foreground="#F5F5F5" VerticalAlignment="Center" Margin="0,0,14,0"/>

                    <Rectangle Width="1" Height="22" Fill="#2A2A2A" Margin="0,0,8,0"/>

                    <!-- In (Zoom In) -->
                    <Button Style="{StaticResource ToolbarButton}" Click="BtnZoomIn_Click" ToolTip="Zoom In">
                        <StackPanel HorizontalAlignment="Center">
                            <Path Data="M 7 2 A 5 5 0 1 1 7 12 A 5 5 0 0 1 7 2 Z M 11 11 L 16 16 M 7 5 L 7 9 M 5 7 L 9 7" Stroke="#9E9E9E" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center"/>
                            <TextBlock Text="Zoom In" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Out (Zoom Out) -->
                    <Button Style="{StaticResource ToolbarButton}" Click="BtnZoomOut_Click" ToolTip="Zoom Out">
                        <StackPanel HorizontalAlignment="Center">
                            <Path Data="M 7 2 A 5 5 0 1 1 7 12 A 5 5 0 0 1 7 2 Z M 11 11 L 16 16 M 5 7 L 9 7" Stroke="#9E9E9E" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center"/>
                            <TextBlock Text="Zoom Out" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Reset View (Home) -->
                    <Button Style="{StaticResource ToolbarButton}" Click="BtnResetView_Click" ToolTip="Reset Zoom &amp; Center Back to Full View (Home)">
                        <StackPanel HorizontalAlignment="Center">
                            <Path Data="M 8 2 L 2 7 L 3.5 7 L 3.5 14 L 6.5 14 L 6.5 10 L 9.5 10 L 9.5 14 L 12.5 14 L 12.5 7 L 14 7 Z" Fill="#9E9E9E" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center"/>
                            <TextBlock Text="Reset" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Random -->
                    <Button Style="{StaticResource ToolbarButton}" Click="BtnRandomize_Click" ToolTip="Randomize Coordinates &amp; View">
                        <StackPanel HorizontalAlignment="Center">
                            <Path Data="M 3 6 L 8 6 L 12 12 L 15 12 M 13 10 L 15 12 L 13 14 M 3 12 L 8 12 L 12 6 L 15 6 M 13 4 L 15 6 L 13 8" Stroke="#9E9E9E" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center"/>
                            <TextBlock Text="Random" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>

                    <Rectangle Width="1" Height="22" Fill="#2A2A2A" Margin="8,0"/>

                    <!-- Equation Entry & Random Equation in Header -->
                    <Border Background="#1C1C1C" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Eq:" FontSize="11" Foreground="#888888" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="TxtHeaderEquation" 
                                     Text="(a + b)^2 + c" 
                                     Width="150" 
                                     Height="24" 
                                     Background="#121212" 
                                     Foreground="#00E5FF" 
                                     BorderBrush="#383838" 
                                     BorderThickness="1" 
                                     FontSize="11" 
                                     FontFamily="Consolas, monospace" 
                                     Padding="4,2" 
                                     VerticalAlignment="Center" 
                                     KeyDown="TxtHeaderEquation_KeyDown"
                                     ToolTip="Enter any equation: (a+b)^2, z^3+c, sin(z)+c, z^4+c..."/>
                            <Button x:Name="BtnApplyHeaderEquation" 
                                    Content="Apply" 
                                    FontSize="10" 
                                    FontWeight="SemiBold" 
                                    Foreground="#f08a4b" 
                                    Background="#252525" 
                                    BorderBrush="#383838" 
                                    BorderThickness="1" 
                                    Padding="8,3" 
                                    Margin="6,0,0,0" 
                                    Cursor="Hand" 
                                    Click="BtnApplyHeaderEquation_Click"
                                    ToolTip="Apply custom equation"/>
                            <Button x:Name="BtnRandEquation" 
                                    Content="Rand Eq" 
                                    FontSize="10" 
                                    Foreground="#CCCCCC" 
                                    Background="#252525" 
                                    BorderBrush="#383838" 
                                    BorderThickness="1" 
                                    Padding="8,3" 
                                    Margin="4,0,0,0" 
                                    Cursor="Hand" 
                                    Click="BtnRandEquation_Click"
                                    ToolTip="Pick a random equation"/>
                        </StackPanel>
                    </Border>

                    <Rectangle Width="1" Height="22" Fill="#2A2A2A" Margin="8,0"/>

                    <!-- Save 4K -->
                    <Button Style="{StaticResource ToolbarButton}" Click="BtnSave_Click" ToolTip="Save 4K Fractal Wallpaper to Disk (Ctrl+S)">
                        <StackPanel HorizontalAlignment="Center">
                            <Path Data="M 9 2 L 9 11 M 5 8 L 9 12 L 13 8 M 2 13 L 2 15 L 16 15 L 16 13" Stroke="#f08a4b" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center"/>
                            <TextBlock Text="Save" FontSize="10" Foreground="#f08a4b" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Copy Image to Clipboard -->
                    <Button Style="{StaticResource ToolbarButton}" Click="BtnCopy_Click" ToolTip="Copy Current Fractal Image to Clipboard (Ctrl+C)">
                        <StackPanel HorizontalAlignment="Center">
                            <Path Data="M 4 2 L 12 2 C 13.1 2 14 2.9 14 4 L 14 12 C 14 13.1 13.1 14 12 14 L 4 14 C 2.9 14 2 13.1 2 12 L 2 4 C 2 2.9 2.9 2 4 2 Z M 6 6 L 16 6 C 17.1 6 18 6.9 18 8 L 18 16 C 18 17.1 17.1 18 16 18 L 6 18 C 4.9 18 4 17.1 4 16 L 4 15 L 6 15 L 6 16 L 16 16 L 16 8 L 15 8 L 15 6 L 16 6" Fill="#9E9E9E" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center"/>
                            <TextBlock Text="Copy" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Right Side: Unified Sidebar Toggle -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton x:Name="TglInspect" Style="{StaticResource ToolbarToggleButton}" IsChecked="True" Click="TglInspect_Click" ToolTip="Toggle Controls Panel">
                        <StackPanel HorizontalAlignment="Center">
                            <Path Data="M 9 6 A 3 3 0 1 1 9 12 A 3 3 0 0 1 9 6 Z M 9 1 L 10.5 3.5 L 13 2 L 13 4.5 L 16 5 L 14.5 7 L 17 8.5 L 14.5 10 L 16 12 L 13 12.5 L 13 15 L 10.5 13.5 L 9 16 L 7.5 13.5 L 5 15 L 5 12.5 L 2 12 L 3.5 10 L 1 8.5 L 3.5 7 L 2 5 L 5 4.5 L 5 2 L 7.5 3.5 Z" Fill="#9E9E9E" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center"/>
                            <TextBlock Text="Controls" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= FULL-SCREEN VIEWPORT WITH FLOATING HUDS ================= -->
        <Grid Grid.Row="1">
            <!-- FULL WINDOW CANVAS VIEWPORT -->
            <Image x:Name="ImgViewport" 
                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                   Stretch="Fill"
                   MouseDown="ImgViewport_MouseDown"
                   MouseUp="ImgViewport_MouseUp"
                   MouseMove="ImgViewport_MouseMove"
                   MouseWheel="ImgViewport_MouseWheel"/>

            <!-- UNIFIED COMBINED PANEL: INSPECTOR & COLORS (RIGHT SIDE, NO CLOSE BUTTON) -->
            <Border x:Name="PnlInspector" 
                    Width="330" 
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Stretch" 
                    Margin="0,12,12,12"
                    Background="#F0161616" 
                    BorderBrush="#2C2C2C" 
                    BorderThickness="1" 
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Title Bar (No close button) -->
                    <Border Grid.Row="0" Background="#202020" CornerRadius="8,8,0,0" Padding="12,8" BorderBrush="#282828" BorderThickness="0,0,0,1">
                        <TextBlock Text="Inspector &amp; Colors" FontSize="12" FontWeight="SemiBold" Foreground="#CCCCCC" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Scrollable Body for Perfect Responsiveness -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14,10,14,14">
                        <StackPanel>
                            <!-- Current Equation Name & Formula Display -->
                            <TextBlock Text="Current Active Equation:" Style="{StaticResource HudLabel}"/>
                            <Border Background="#101010" BorderBrush="#252525" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock x:Name="TxtFormulaTitle" Text="Mandelbrot Set" Foreground="#F5F5F5" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="TxtFormulaDisplay" Text="z_{n+1} = z_n^2 + c" Foreground="#00E5FF" FontSize="11" FontStyle="Italic" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Enter Custom Mathematical Formula -->
                            <TextBlock Text="Enter Your Equation:" Style="{StaticResource HudLabel}"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtInspectorEquation" 
                                         Text="(a + b)^2 + c" 
                                         Style="{StaticResource HudInput}" 
                                         Margin="0,0,6,0" 
                                         KeyDown="TxtInspectorEquation_KeyDown"/>
                                <Button Grid.Column="1" 
                                        Content="Apply" 
                                        FontSize="11" 
                                        FontWeight="SemiBold" 
                                        Foreground="#f08a4b" 
                                        Background="#252525" 
                                        BorderBrush="#383838" 
                                        BorderThickness="1" 
                                        Padding="10,2" 
                                        Cursor="Hand" 
                                        Click="BtnApplyInspectorEquation_Click"/>
                            </Grid>

                            <!-- Presets & Landmarks (Michael Fogleman's Scale Landmarks + Classic Chaos) -->
                            <DockPanel Margin="0,2,0,2">
                                <TextBlock Text="Landmarks &amp; Scale Presets:" Style="{StaticResource HudLabel}" DockPanel.Dock="Left"/>
                                <Button Content="Rand Landmark" FontSize="10" Foreground="#f08a4b" Background="Transparent" BorderThickness="0" Cursor="Hand" DockPanel.Dock="Right" Click="BtnRandLandmark_Click" ToolTip="Jump to a random landmark"/>
                            </DockPanel>
                            <ComboBox x:Name="CmbLandmarks" Height="28" Margin="0,0,0,10" SelectionChanged="CmbLandmarks_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="2,2">
                                            <TextBlock Text="{Binding Title}" Foreground="#F5F5F5" FontWeight="SemiBold" FontSize="11" DockPanel.Dock="Left"/>
                                            <TextBlock Text="{Binding Category}" Foreground="#888888" FontSize="10" FontStyle="Italic" HorizontalAlignment="Right" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- Preset Equations Dropdown -->
                            <DockPanel Margin="0,2,0,2">
                                <TextBlock Text="Or Choose Equation:" Style="{StaticResource HudLabel}" DockPanel.Dock="Left"/>
                                <Button Content="Random" FontSize="10" Foreground="#A0A0A0" Background="Transparent" BorderThickness="0" Cursor="Hand" DockPanel.Dock="Right" Click="BtnRandEquation_Click"/>
                            </DockPanel>
                            <ComboBox x:Name="CmbAllEquations" Height="28" Margin="0,0,0,10" SelectionChanged="CmbAllEquations_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="2,2">
                                            <TextBlock Text="{Binding Name}" Foreground="#F5F5F5" FontWeight="SemiBold" FontSize="11" DockPanel.Dock="Left"/>
                                            <TextBlock Text="{Binding FormulaLatex}" Foreground="#f08a4b" FontSize="10" FontStyle="Italic" HorizontalAlignment="Right" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <Separator Background="#262626" Margin="0,0,0,8"/>

                            <!-- Center Coordinates -->
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Center X" Style="{StaticResource HudLabel}"/>
                                    <TextBox x:Name="TxtCenterX" Style="{StaticResource HudInput}" LostFocus="TxtCenter_LostFocus" KeyDown="TxtCenter_KeyDown"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Center Y" Style="{StaticResource HudLabel}"/>
                                    <TextBox x:Name="TxtCenterY" Style="{StaticResource HudInput}" LostFocus="TxtCenter_LostFocus" KeyDown="TxtCenter_KeyDown"/>
                                </StackPanel>
                            </Grid>
                            <DockPanel Margin="0,0,0,6">
                                <Button Content="📋 Copy Coords" FontSize="10" Foreground="#A0A0A0" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" Padding="6,2" Cursor="Hand" DockPanel.Dock="Right" Click="BtnCopyCoords_Click" ToolTip="Copy coordinates and settings to clipboard (Ctrl+Shift+C)"/>
                            </DockPanel>

                            <!-- Zoom Slider -->
                            <DockPanel Margin="0,2,0,0">
                                <TextBlock Text="Zoom (Distance)" Style="{StaticResource HudLabel}" DockPanel.Dock="Left"/>
                                <Button Content="Reset" FontSize="9" Foreground="#f08a4b" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="6,0,0,0" DockPanel.Dock="Left" Click="BtnResetView_Click" ToolTip="Reset view to default framing"/>
                                <TextBox x:Name="TxtZoomValue" Text="250" Style="{StaticResource HudInput}" Width="55" HorizontalContentAlignment="Center" DockPanel.Dock="Right" LostFocus="TxtZoomValue_LostFocus" KeyDown="TxtZoomValue_KeyDown"/>
                            </DockPanel>
                            <Slider x:Name="SldZoom" Minimum="3" Maximum="26" Value="8" ValueChanged="SldZoom_ValueChanged"/>

                            <!-- Detail Slider -->
                            <DockPanel Margin="0,2,0,0">
                                <TextBlock Text="Detail (Iterations)" Style="{StaticResource HudLabel}" DockPanel.Dock="Left"/>
                                <TextBox x:Name="TxtDetailValue" Text="200" Style="{StaticResource HudInput}" Width="55" HorizontalContentAlignment="Center" DockPanel.Dock="Right" LostFocus="TxtDetailValue_LostFocus" KeyDown="TxtDetailValue_KeyDown"/>
                            </DockPanel>
                            <Slider x:Name="SldDetail" Minimum="30" Maximum="600" Value="200" ValueChanged="SldDetail_ValueChanged"/>

                            <!-- Exponent Slider -->
                            <DockPanel Margin="0,2,0,0">
                                <TextBlock Text="Exponent (Symmetry / Power)" Style="{StaticResource HudLabel}" DockPanel.Dock="Left"/>
                                <TextBox x:Name="TxtExponentValue" Text="2" Style="{StaticResource HudInput}" Width="55" HorizontalContentAlignment="Center" DockPanel.Dock="Right" LostFocus="TxtExponentValue_LostFocus" KeyDown="TxtExponentValue_KeyDown"/>
                            </DockPanel>
                            <Slider x:Name="SldExponent" Minimum="2" Maximum="6" Value="2" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="SldExponent_ValueChanged"/>

                            <!-- ================= COLORS & PALETTES SECTION ================= -->
                            <Separator Background="#282828" Margin="0,6,0,8"/>
                            <TextBlock Text="Color Palette Preset (All Vibrant Colors):" Style="{StaticResource HudLabel}"/>
                            <ComboBox x:Name="CmbPalette" Height="30" Margin="0,0,0,8" SelectionChanged="CmbPalette_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="2,2">
                                            <Border Width="65" Height="15" CornerRadius="2" BorderBrush="#383838" BorderThickness="1" Background="{Binding PreviewBrush}" Margin="0,0,8,0" DockPanel.Dock="Left"/>
                                            <TextBlock Text="{Binding Name}" Foreground="#F5F5F5" FontSize="11" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- Live Gradient Preview Bar -->
                            <Border x:Name="BrdGradientPreview" Height="22" CornerRadius="3" BorderBrush="#333333" BorderThickness="1" Margin="0,0,0,10">
                                <Border.Background>
                                    <LinearGradientBrush x:Name="GrdPreviewBrush" StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#020614" Offset="0.0"/>
                                        <GradientStop Color="#0046B4" Offset="0.3"/>
                                        <GradientStop Color="#00BEFF" Offset="0.65"/>
                                        <GradientStop Color="#96EBFF" Offset="0.85"/>
                                        <GradientStop Color="#FFFFFF" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- Gamma Slider -->
                            <DockPanel Margin="0,2,0,0">
                                <TextBlock Text="Gamma (Contrast &amp; Curve):" Style="{StaticResource HudLabel}" DockPanel.Dock="Left"/>
                                <TextBlock x:Name="TxtGammaDisplay" Text="1.0" Foreground="#f08a4b" FontSize="11" FontWeight="SemiBold" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Slider x:Name="SldGamma" Minimum="0.2" Maximum="2.5" Value="1.0" ValueChanged="SldGamma_ValueChanged"/>

                            <!-- Antialiasing & Smooth Toggles -->
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="ChkSmooth" Content="Smooth Gradient" IsChecked="True" Foreground="#A0A0A0" VerticalAlignment="Center" Checked="ChkRendering_Changed" Unchecked="ChkRendering_Changed"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="AA: " Style="{StaticResource HudLabel}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <ComboBox x:Name="CmbAntialiasing" Height="24" Width="60" SelectionChanged="CmbAntialiasing_SelectionChanged">
                                        <ComboBoxItem Content="1x" IsSelected="True"/>
                                        <ComboBoxItem Content="2x"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Status Pill (Bottom Center) -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12" Background="#D00A0A0A" BorderBrush="#262626" BorderThickness="1" CornerRadius="12" Padding="14,4" IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TxtStatusMode" Text="Electric Cyan Fractal" FontWeight="SemiBold" Foreground="#00E5FF" FontSize="11" Margin="0,0,12,0"/>
                    <TextBlock Text="•" Foreground="#555" Margin="0,0,12,0"/>
                    <TextBlock x:Name="TxtStatusZoom" Text="Zoom: 250x" Foreground="#F5F5F5" FontSize="11" Margin="0,0,12,0"/>
                    <TextBlock Text="•" Foreground="#555" Margin="0,0,12,0"/>
                    <TextBlock x:Name="TxtStatusRender" Text="12 ms" Foreground="#9E9E9E" FontSize="11"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= EXPORT PROGRESS MODAL OVERLAY ================= -->
        <Grid x:Name="OverlayExportProgress" 
              Grid.Row="0" 
              Grid.RowSpan="2" 
              Background="#CC0A0A0A" 
              Visibility="Collapsed" 
              Panel.ZIndex="1000">
            <!-- Modal Card (Centered, sleek dark theme with drop shadow & accent border) -->
            <Border Width="480" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center" 
                    Background="#181818" 
                    BorderBrush="#383838" 
                    BorderThickness="1" 
                    CornerRadius="12" 
                    Padding="26,22">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="35" Color="#000000" Opacity="0.85" ShadowDepth="8"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Header with Icon & Title -->
                    <DockPanel Margin="0,0,0,14">
                        <Border Width="40" Height="40" CornerRadius="8" Background="#261A12" BorderBrush="#f08a4b" BorderThickness="1" Margin="0,0,14,0" DockPanel.Dock="Left">
                            <Path Data="M 9 2 L 9 11 M 5 8 L 9 12 L 13 8 M 2 13 L 2 15 L 16 15 L 16 13" Stroke="#f08a4b" StrokeThickness="2" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Exporting Ultra HD Wallpaper" FontSize="15" FontWeight="Bold" Foreground="#F5F5F5"/>
                            <TextBlock x:Name="TxtExportSubtitle" Text="Rendering 4K UHD (3840 × 2160) • Mandelbrot Set" FontSize="11" Foreground="#9E9E9E" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Target Resolution & Settings Details Box -->
                    <Border Background="#121212" BorderBrush="#252525" BorderThickness="1" CornerRadius="6" Padding="12,9" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="TxtExportFilename" Text="Scale_Export.png" FontSize="11" FontWeight="SemiBold" Foreground="#00E5FF" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="Supersampling: 2x Antialiased • Multi-threaded CPU" FontSize="10" Foreground="#777777" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="3840 × 2160 (4K)" FontSize="11" FontWeight="SemiBold" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Progress Bar -->
                    <Grid Margin="0,0,0,8">
                        <ProgressBar x:Name="PrgExport" 
                                     Height="10" 
                                     Minimum="0" 
                                     Maximum="100" 
                                     Value="0" 
                                     Background="#222222" 
                                     BorderThickness="0"/>
                    </Grid>

                    <!-- Percentage & Live Scanline Status Row -->
                    <DockPanel Margin="0,0,0,18">
                        <TextBlock x:Name="TxtExportStatus" Text="Rendering scanlines..." FontSize="11" Foreground="#AAAAAA" DockPanel.Dock="Left"/>
                        <TextBlock x:Name="TxtExportPercent" Text="0%" FontSize="12" FontWeight="Bold" Foreground="#f08a4b" DockPanel.Dock="Right"/>
                    </DockPanel>

                    <!-- Action Buttons: Cancel -->
                    <DockPanel>
                        <Button x:Name="BtnCancelExport" 
                                Content="Cancel Export" 
                                FontSize="11" 
                                FontWeight="SemiBold" 
                                Foreground="#CCCCCC" 
                                Background="#242424" 
                                BorderBrush="#3A3A3A" 
                                BorderThickness="1" 
                                Padding="16,6" 
                                Cursor="Hand" 
                                HorizontalAlignment="Right" 
                                Click="BtnCancelExport_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="BtnBrd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="BtnBrd" Property="Background" Value="#3D1C1C"/>
                                                        <Setter TargetName="BtnBrd" Property="BorderBrush" Value="#FF4B4B"/>
                                                        <Setter Property="Foreground" Value="#FF6B6B"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
